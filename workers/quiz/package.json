{
  "name": "dashboard-quiz",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Quiz interativo /q/{slug} — example.com",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "d1:apply:local": "wrangler d1 execute quiz-db --local --file=./migrations/d1/0001_init.sql",
    "d1:apply:remote": "wrangler d1 execute quiz-db --remote --file=./migrations/d1/0001_init.sql",
    "kv:put-config": "wrangler kv key put --binding=QUIZ_KV"
  },
  "devDependencies": {
    "wrangler": "^3.99.0"
  }
}
